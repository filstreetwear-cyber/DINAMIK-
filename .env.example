# --- runtime ---
ENVIRONMENT=development
MOCK_MODE=true
LOG_LEVEL=INFO

# --- database / queue ---
DATABASE_URL=postgresql+asyncpg://dinamik:dinamik@localhost:5432/dinamik_amazon_intelligence
REDIS_URL=redis://localhost:6379/0

# --- AI provider ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Amazon SP-API ---
# Account-scoped: funziona solo su un account Amazon a cui e' stato concesso
# accesso (un cliente gia' gestito da Dinamik). NON e' usato dall'Amazon Scout
# per la discovery di nuovi prospect - e' per i futuri Agent 02/Ads Agent.
AMAZON_API_KEY=
AMAZON_API_SECRET=
AMAZON_MARKETPLACE=IT
AMAZON_SELLER_ID=

# --- data provider usati dall'Amazon Scout per la discovery ---
KEEPA_API_KEY=
JUNGLESCOUT_API_KEY=
JUNGLESCOUT_KEY_NAME=
PERPETUA_API_KEY=

# Helium 10: confermato come UNICO tool dati disponibile per Dinamik (21/09).
# Diventa quindi il connector prioritario per Milestone 3/4/5. Resta pero'
# aperto se il piano attuale include l'Enterprise API (self-serve via
# contatto commerciale) o solo l'accesso da dashboard: da questo dipende
# se questo connector potra' mai avere dati reali o restera' mock-only.
HELIUM10_API_KEY=

# --- feature flags ---
ENABLE_KEEPA=false
ENABLE_JUNGLESCOUT=false
ENABLE_PERPETUA=false
ENABLE_HELIUM10=false
ENABLE_AI_ANALYSIS=true
ENABLE_SCHEDULER=false
ENABLE_EXPORT=true

# --- browser automation (Phase F, refactor 21/09) ---
# Dove vivono i profili browser persistenti (cookie/login salvati). Sulla
# VPS del progetto deve puntare a un volume montato (Phase J), così un
# login umano sopravvive a un redeploy. Generico — nessun riferimento a
# Helium10: quel provider resta sospeso (vedi docs/architecture.md).
BROWSER_PROFILES_DIR=data/browser_profiles
BROWSER_HEADLESS=true
