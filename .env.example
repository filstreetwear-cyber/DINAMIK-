# --- runtime ---
ENVIRONMENT=development
MOCK_MODE=true
LOG_LEVEL=INFO

# --- database / queue ---
DATABASE_URL=postgresql+asyncpg://dinamik:dinamik@localhost:5432/dinamik_amazon_intelligence
REDIS_URL=redis://localhost:6379/0

# --- AI provider ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Amazon SP-API ---
# Account-scoped: funziona solo su un account Amazon a cui e' stato concesso
# accesso (un cliente gia' gestito da Dinamik). NON e' usato dall'Amazon Scout
# per la discovery di nuovi prospect - e' per i futuri Agent 02/Ads Agent.
AMAZON_API_KEY=
AMAZON_API_SECRET=
AMAZON_MARKETPLACE=IT
AMAZON_SELLER_ID=

# --- data provider usati dall'Amazon Scout per la discovery ---
KEEPA_API_KEY=
JUNGLESCOUT_API_KEY=
JUNGLESCOUT_KEY_NAME=
PERPETUA_API_KEY=

# Helium 10: API disponibile SOLO sul piano Enterprise, accesso non
# self-serve (richiede contatto commerciale). Non aspettarti di popolare
# questa chiave senza una trattativa separata.
HELIUM10_API_KEY=

# --- feature flags ---
ENABLE_KEEPA=false
ENABLE_JUNGLESCOUT=false
ENABLE_PERPETUA=false
ENABLE_HELIUM10=false
ENABLE_AI_ANALYSIS=true
ENABLE_SCHEDULER=false
ENABLE_EXPORT=true
