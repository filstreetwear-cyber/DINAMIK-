# --- runtime ---
ENVIRONMENT=development
MOCK_MODE=true
LOG_LEVEL=INFO

# --- database / queue ---
DATABASE_URL=postgresql+asyncpg://dinamik:dinamik@localhost:5432/dinamik_amazon_intelligence
REDIS_URL=redis://localhost:6379/0

# --- AI provider ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Amazon SP-API ---
# Account-scoped: funziona solo su un account Amazon a cui e' stato concesso
# accesso (un cliente gia' gestito da Dinamik). NON e' usato dall'Amazon Scout
# per la discovery di nuovi prospect - e' per i futuri Agent 02/Ads Agent.
AMAZON_API_KEY=
AMAZON_API_SECRET=
AMAZON_MARKETPLACE=IT
AMAZON_SELLER_ID=

# --- data provider usati dall'Amazon Scout per la discovery ---
KEEPA_API_KEY=
JUNGLESCOUT_API_KEY=
JUNGLESCOUT_KEY_NAME=
PERPETUA_API_KEY=

# Helium 10: confermato come UNICO tool dati disponibile per Dinamik (21/09).
# Diventa quindi il connector prioritario per Milestone 3/4/5. Resta pero'
# aperto se il piano attuale include l'Enterprise API (self-serve via
# contatto commerciale) o solo l'accesso da dashboard: da questo dipende
# se questo connector potra' mai avere dati reali o restera' mock-only.
HELIUM10_API_KEY=

# --- feature flags ---
ENABLE_KEEPA=false
ENABLE_JUNGLESCOUT=false
ENABLE_PERPETUA=false
ENABLE_HELIUM10=false
ENABLE_AI_ANALYSIS=true
ENABLE_SCHEDULER=false
ENABLE_EXPORT=true

# --- browser automation (Phase F, refactor 21/09) ---
# Dove vivono i profili browser persistenti (cookie/login salvati). Sulla
# VPS del progetto deve puntare a un volume montato (Phase J), così un
# login umano sopravvive a un redeploy. Generico — nessun riferimento a
# Helium10: quel provider resta sospeso (vedi docs/architecture.md).
BROWSER_PROFILES_DIR=data/browser_profiles
BROWSER_HEADLESS=true
# Dove Playwright trova il binario Chromium. Vuoto = usa il default hardcoded
# di questo sandbox di sviluppo (/opt/pw-browsers/chromium). L'immagine
# Docker browser-worker (Phase J) installa Chromium per conto proprio e crea
# un symlink equivalente allo stesso path, quindi anche li' puo' restare
# vuoto — valorizzalo solo se il tuo setup mette il binario altrove.
BROWSER_EXECUTABLE_PATH=

# --- Weekly Intelligence Scan (feature, 2026-09-21) ---
# Dove atterrano i report markdown persistiti di ogni scan settimanale.
WEEKLY_REPORTS_DIR=reports/weekly

# --- Milestone 15: Exports (21/09) ---
# Dove atterrano i workbook .xlsx generati da `dinamik export brands`.
EXPORTS_DIR=exports

# --- Post Reality Audit (22/09): Docker -> Ollama networking fix ---
# Lasciala vuota in locale (config/default.yaml's ai.local.base_url resta
# http://localhost:11434, corretto fuori Docker). Necessaria SOLO quando
# l'app gira dentro un container Docker e Ollama gira sull'host: dentro un
# container, "localhost" risolve al container stesso, non all'host.
# docker-compose.yml la valorizza gia' di default a
# http://host.docker.internal:11434 per api/worker/beat (via extra_hosts:
# host.docker.internal:host-gateway) -- sovrascrivi qui solo se
# l'indirizzo reale di Ollama sulla VPS e' diverso (mai verificato contro
# una VPS reale, vedi Reality Audit §12/§18).
OLLAMA_BASE_URL=
